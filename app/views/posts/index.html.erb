<h1>予定一覧</h1>

<table>

<thead>
<tr>
  <th>ID</th>
  <th>タイトル</th>
  <th>開始日</th>
  <th>終了日</th>
</tr>
</thead>
<tbody>
<% @posts.each do |post| %>
 <tr>
   <td><%= post.id %></td>
   <td><%= post.title %></td>
   <td><%= post.start_date %></td>
   <td><%= post.end_date %></td>
 </tr>
<% end %>
</tbody>
</table>